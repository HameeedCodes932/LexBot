# ── LLM Provider Keys ─────────────────────────────────────────────────
# At least one of these must be set
GROQ_API_KEY=""
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""
GOOGLE_API_KEY=""
DEFAULT_LLM_PROVIDER="groq"

# ── Hugging Face (optional, for faster embedding model downloads) ──────
HF_TOKEN=""

# ── JWT / Auth ─────────────────────────────────────────────────────────
SECRET_KEY="change-me-to-a-random-secret"

# ── Database (local dev) ───────────────────────────────────────────────
DATABASE_URL="postgresql+asyncpg://postgres:postgres@localhost:5432/lexbot"
# For Supabase (production): postgresql+asyncpg://postgres:password@aws-0-region.pooler.supabase.com:6543/postgres

# ── Supabase (file storage) ────────────────────────────────────────────
SUPABASE_URL=""
SUPABASE_KEY=""
SUPABASE_STORAGE_BUCKET="lexbot-uploads"

# ── Stripe / Billing ───────────────────────────────────────────────────
# Leave empty for demo mode (all features free)
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PRICE_PRO="price_pro"
STRIPE_PRICE_ENTERPRISE="price_enterprise"

# ── White-label ────────────────────────────────────────────────────────
FIRM_NAME="LexBot"
PRIMARY_COLOR="navy blue"

# ── CORS ───────────────────────────────────────────────────────────────
CORS_ORIGINS="http://localhost:5173,http://localhost:3000,http://localhost:8000"

# ── Sentry (optional) ──────────────────────────────────────────────────
SENTRY_DSN=""

# ── Data Encryption at Rest (optional) ─────────────────────────────────
ENCRYPTION_ENABLED="false"
ENCRYPTION_KEY=""
DATA_RETENTION_DAYS="30"

# ── Legal / Compliance ─────────────────────────────────────────────────
AI_DISCLAIMER_ENABLED="true"

# ── Agent (SMTP for email tools) ──────────────────────────────────────
SMTP_EMAIL=
SMTP_PASSWORD=
